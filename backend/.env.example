PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase (optional; enables JWT auth context path and future DB integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# LLM provider (optional, provider-independent). If unset, mock provider is used (no paid APIs required).
# Gemini (set GEMINI_API_KEY to enable):
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# OpenAI-compatible endpoint:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Real HTTP/webhook tool execution (optional, disabled by default). Only enable when authorized and configured.
ENABLE_REAL_HTTP_TOOLS=false
DEFAULT_WEBHOOK_URL=
HTTP_TOOL_AUTH_HEADER=
HTTP_TOOL_AUTH_VALUE=
# Secrets must be supplied via secure env/secret manager refs in production; never expose in frontend.
